diff --git a/MFAAvalonia/Helper/TaskOptionGenerator.cs b/MFAAvalonia/Helper/TaskOptionGenerator.cs
index ed3a642..d315cc6 100644
--- a/MFAAvalonia/Helper/TaskOptionGenerator.cs
+++ b/MFAAvalonia/Helper/TaskOptionGenerator.cs
@@ -34,7 +34,205 @@ public class TaskOptionGenerator(TaskQueueViewModel viewModel, Action saveConfig
     private static readonly Thickness OptionRowMargin = new(10, 3, 10, 3);
     private static readonly Thickness NestedOptionMargin = new(14, 2, 4, 4);
     private static readonly Thickness NestedOptionPadding = new(8, 4, 6, 4);
+
+    private static bool UseChipTaskCheckBox(string? name) =>
+        name == "根据自定义设置锁定/解锁仓库内芯片";
+
+    private static bool IsLimitedTradeChipTypeOption(string? name) =>
+        name == "限时贸易_芯片箱类型";
+
+    private static bool IsLimitedTradeChipQualityOption(string? name) =>
+        name?.StartsWith("限时贸易_", StringComparison.Ordinal) == true &&
+        name.EndsWith("芯片箱品质", StringComparison.Ordinal);
+
+    /// <summary>
+    /// LAA: 从「限时贸易_特防芯片箱品质」取出对应的类型 case 名「特防」。
+    /// 联动需要用它回到上级「限时贸易_芯片箱类型」的对应按钮。
+    /// </summary>
+    /// <summary>
+    /// LAA: 芯片箱类型名（如「特防」）-> 该类型的 ToggleButton。
+    ///
+    /// 用类级注册表而不是闭包捕获，是因为品质按钮可能在父按钮之后被反复重建
+    /// （父项每次 UpdateSubOptions 都会重建子控件），闭包里的旧引用会失效。
+    /// 每次创建父按钮时覆盖登记，保证品质回调拿到的是当前有效的那一个。
+    /// </summary>
+    private static readonly Dictionary<string, ToggleButton> LimitedTradeChipTypeToggles =
+        new(StringComparer.Ordinal);
+
+    private static string? LimitedTradeChipTypeNameOf(string? qualityOptionName)
+    {
+        const string prefix = "限时贸易_";
+        const string suffix = "芯片箱品质";
+        if (qualityOptionName == null ||
+            !qualityOptionName.StartsWith(prefix, StringComparison.Ordinal) ||
+            !qualityOptionName.EndsWith(suffix, StringComparison.Ordinal))
+            return null;
+        var typeName = qualityOptionName.Substring(prefix.Length,
+            qualityOptionName.Length - prefix.Length - suffix.Length);
+        return typeName.Length == 0 ? null : typeName;
+    }
+
+    /// <summary>
+    /// LAA: 空品质勾选状态会被存档固化成「一个都不勾」，而且界面上无法回到默认。
+    /// MFA 用存档覆盖接口 default_case，所以接口里的 ["R4","R5"] 只在从未保存过时生效。
+    /// 这里在生成面板时把空的品质列表规范化成「全部品质」（R4+R5）。
+    /// </summary>
+    private static void NormalizeLimitedTradeChipQualitySelection(
+        MaaInterface.MaaInterfaceSelectOption option, MaaInterface.MaaInterfaceOption interfaceOption)
+    {
+        if (!IsLimitedTradeChipQualityOption(option.Name))
+            return;
+        if (option.SelectedCases == null)
+            option.SelectedCases = new List<string>(interfaceOption.DefaultCases ?? new List<string>());
+        if (option.SelectedCases.Count > 0)
+            return;
+        var all = (interfaceOption.Cases ?? new List<MaaInterface.MaaInterfaceOptionCase>())
+            .Select(item => item.Name)
+            .Where(name => !string.IsNullOrEmpty(name))
+            .Select(name => name!)
+            .ToList();
+        if (all.Count > 0)
+            option.SelectedCases.AddRange(all);
+    }
+
+    // LAA: daily chip-stage availability is evaluated from the computer's
+    // local calendar whenever the task settings panel is generated.
+    private static readonly Dictionary<string, DayOfWeek[]> DailyChipStageSchedule = new()
+    {
+        ["鼓军嵌合"] = [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Thursday, DayOfWeek.Friday],
+        ["光杵嵌合"] = [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Friday],
+        ["注刈嵌合"] = [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday],
+        ["链接嵌合"] = [DayOfWeek.Monday, DayOfWeek.Saturday, DayOfWeek.Sunday],
+        ["体魄嵌合"] = [DayOfWeek.Tuesday, DayOfWeek.Saturday, DayOfWeek.Sunday],
+        ["侵蚀嵌合"] = [DayOfWeek.Wednesday],
+        ["迅刃嵌合"] = [DayOfWeek.Thursday],
+        ["矛盾嵌合"] = [DayOfWeek.Friday],
+    };
+
+    private static bool IsChipStage(string? caseName) =>
+        caseName?.Contains("嵌合（", StringComparison.Ordinal) == true;
+
+    private static List<MaaInterface.MaaInterfaceOptionCase>? GetVisibleCases(
+        string? optionName,
+        List<MaaInterface.MaaInterfaceOptionCase>? allCases)
+    {
+        if (allCases == null || optionName != "关卡选择")
+            return allCases;
+
+        var today = DateTime.Now.DayOfWeek;
+        if (today is DayOfWeek.Saturday or DayOfWeek.Sunday)
+            return allCases;
+
+        return allCases.Where(item =>
+        {
+            if (!IsChipStage(item.Name))
+                return true;
+
+            var stageName = DailyChipStageSchedule.Keys.FirstOrDefault(name =>
+                item.Name?.StartsWith(name, StringComparison.Ordinal) == true);
+            return stageName == null || DailyChipStageSchedule[stageName].Contains(today);
+        }).ToList();
+    }
     
+    /// <summary>
+    /// LAA: 一次性规范化「限时贸易_芯片箱类型」下所有品质的存档状态。
+    ///
+    /// 为什么必须独立于控件生成：品质控件只在**对应类型被勾选时**才会创建，
+    /// 所以未勾选类型里的空品质（存档遗留）永远不会被规范化到。
+    /// 用户之后再勾上该类型，读到的仍是空列表 —— 就是「一个品质都不勾」的复现路径。
+    ///
+    /// 这里对全部类型做两件事：
+    ///   * 品质存档为空的 -> 填成全部品质（R4+R5）并落盘；
+    ///   * 类型已勾选、但其品质一个都没勾 -> 取消该类型（避免界面自相矛盾）。
+    /// </summary>
+    private void NormalizeLimitedTradeChipQualityOptions(DragItemViewModel dragItem)
+    {
+        if (MaaProcessor.Interface?.Option?.TryGetValue("限时贸易_芯片箱类型", out var chipTypes) != true)
+            return;
+        if (chipTypes.Cases == null)
+            return;
+
+        var selected = new HashSet<string>(StringComparer.Ordinal);
+        CollectLimitedTradeSelections(dragItem, selected);
+
+        var dirty = false;
+        foreach (var caseItem in chipTypes.Cases)
+        {
+            if (caseItem.Option == null || caseItem.Option.Count == 0)
+                continue;
+            var onlyQualityEmpty = true;
+            foreach (var qualityName in caseItem.Option)
+            {
+                if (!MaaProcessor.Interface.Option.TryGetValue(qualityName, out var qualityInterface))
+                    continue;
+                var qualityOption = FindLimitedTradeOption(dragItem, qualityName);
+                if (qualityOption == null)
+                    continue;
+                if (qualityOption.SelectedCases == null)
+                {
+                    qualityOption.SelectedCases = new List<string>(
+                        qualityInterface.DefaultCases ?? new List<string>());
+                }
+                if (qualityOption.SelectedCases.Count == 0)
+                {
+                    var all = (qualityInterface.Cases ?? new List<MaaInterface.MaaInterfaceOptionCase>())
+                        .Select(item => item.Name)
+                        .Where(name => !string.IsNullOrEmpty(name))
+                        .Select(name => name!)
+                        .ToList();
+                    if (all.Count > 0)
+                    {
+                        qualityOption.SelectedCases.AddRange(all);
+                        dirty = true;
+                    }
+                }
+                if (qualityOption.SelectedCases.Count > 0)
+                    onlyQualityEmpty = false;
+            }
+            // 类型勾着但品质全空：取消该类型，让界面不再出现空档
+            if (onlyQualityEmpty && selected.Contains(caseItem.Name ?? string.Empty))
+            {
+                var typeOption = FindLimitedTradeOption(dragItem, "限时贸易_芯片箱类型");
+                if (typeOption?.SelectedCases?.Remove(caseItem.Name ?? string.Empty) == true)
+                    dirty = true;
+            }
+        }
+
+        if (dirty)
+            saveConfigurationAction();
+    }
+
+    private static IEnumerable<MaaInterface.MaaInterfaceSelectOption> WalkLimitedTradeOptions(
+        DragItemViewModel dragItem)
+    {
+        var roots = dragItem.InterfaceItem?.Option;
+        if (roots == null)
+            yield break;
+        var stack = new Stack<MaaInterface.MaaInterfaceSelectOption>(roots);
+        while (stack.Count > 0)
+        {
+            var option = stack.Pop();
+            yield return option;
+            foreach (var sub in option.SubOptions ?? new List<MaaInterface.MaaInterfaceSelectOption>())
+                stack.Push(sub);
+        }
+    }
+
+    private static void CollectLimitedTradeSelections(DragItemViewModel dragItem, HashSet<string> selected)
+    {
+        foreach (var option in WalkLimitedTradeOptions(dragItem))
+        {
+            if (option.Name != "限时贸易_芯片箱类型")
+                continue;
+            foreach (var name in option.SelectedCases ?? new List<string>())
+                selected.Add(name);
+        }
+    }
+
+    private static MaaInterface.MaaInterfaceSelectOption? FindLimitedTradeOption(
+        DragItemViewModel dragItem, string optionName) =>
+        WalkLimitedTradeOptions(dragItem).FirstOrDefault(item => item.Name == optionName);
+
