+
+    // LAA: 竞技场「放宽后的最低积分」只在启用了兜底时才显示 —— 下拉框选「从不」就藏起来。
+    // 刻意不做成二级菜单：它是独立的平铺输入框，不是下拉框的子项。
+    // 选项名写死在这里是因为 interface.schema.json 的 option 定义是 additionalProperties:false，
+    // 加不了自定义的「依赖 / 可见性」字段（加了会被 validate_schema 拦下）。
+    internal const string ArenaFallbackThresholdOption = "刷新次数放宽阈值";
+    internal const string ArenaFallbackPointsOption = "放宽后的最低积分";
+
+    private void ApplyConditionalOptionVisibility(StackPanel panel)
+    {
+        var thresholdRow = panel.Children
+            .OfType<Control>()
+            .FirstOrDefault(c => (c.Tag as string) == ArenaFallbackThresholdOption);
+        var pointsRow = panel.Children
+            .OfType<Control>()
+            .FirstOrDefault(c => (c.Tag as string) == ArenaFallbackPointsOption);
+        if (thresholdRow == null || pointsRow == null) return;
+
+        var comboBox = FindDescendant<ComboBox>(thresholdRow);
+        if (comboBox == null) return;
+
+        void SyncVisibility() => pointsRow.IsVisible = comboBox.SelectedIndex > 0;
+        comboBox.SelectionChanged += (_, _) => SyncVisibility();
+        SyncVisibility();
+    }
+
+    private static T? FindDescendant<T>(Control root) where T : Control
+    {
+        if (root is T hit) return hit;
+        if (root is not Panel panel) return null;
+        foreach (var child in panel.Children)
+        {
+            if (child is Control control && FindDescendant<T>(control) is { } found) return found;
+        }
+        return null;
     }
 
